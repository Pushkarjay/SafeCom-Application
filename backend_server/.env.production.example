# SafeCom Backend - Production Environment Template
# COPY THIS FILE TO `.env.production` AND FILL IN REAL VALUES
# DO NOT COMMIT .env.production TO GIT

# ============================================================================
# Node.js & Express
# ============================================================================
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ============================================================================
# Firebase / Firestore
# ============================================================================
FIREBASE_PROJECT_ID=safecom-application-01
FIRESTORE_DATABASE_ID=projects/safecom-application-01/databases/(default)

# Path to service account JSON (stored securely in /run/secrets or Secret Manager)
# On deployment, mount this at a secure path
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/safecom-backend-sa-key.json

# ============================================================================
# Backend URLs & CORS
# ============================================================================
# Production backend domain
BACKEND_URL=https://api.safecom.in

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=https://safecom.in,https://admin.safecom.in,https://app.safecom.in

# ============================================================================
# JWT & Authentication
# ============================================================================
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRY=7d

# ============================================================================
# Maps API
# ============================================================================
GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_MAPS_API_KEY

# ============================================================================
# Database
# ============================================================================
# Not needed for Firestore - IAM auth via GOOGLE_APPLICATION_CREDENTIALS
# If Cloud SQL is added later, add connection string here

# ============================================================================
# Logging & Monitoring
# ============================================================================
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Cloud Logging (if using Google Cloud Logging)
GOOGLE_CLOUD_LOGGING_ENABLED=true

# ============================================================================
# Rate Limiting & Security
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# Email / OTP (if configured)
# ============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=REPLACE_WITH_EMAIL
# SMTP_PASSWORD=REPLACE_WITH_APP_PASSWORD
# SMTP_FROM=noreply@safecom.in

# ============================================================================
# Mobile App IDs (for validation)
# ============================================================================
CUSTOMER_APP_ID=com.safecom.customer
EMPLOYEE_APP_ID=com.safecom.employee

# ============================================================================
# Deployment Info
# ============================================================================
APP_VERSION=1.0.0
DEPLOYMENT_REGION=asia-south1
DEPLOYMENT_DATE=REPLACE_WITH_DEPLOYMENT_DATE
