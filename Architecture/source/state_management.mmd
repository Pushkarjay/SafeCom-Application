%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#4285F4'}}}%%
flowchart TB
    subgraph "Customer App State Management"
        subgraph "Data Layer"
            Cart["🛒 CartProvider"]:::data
            DataP["📊 DataProviders"]:::data
        end

        subgraph "Feature Providers"
            AuthP["🔐 AuthProvider"]:::provider
            LocationP["📍 LocationProvider"]:::provider
            HomeP["🏠 HomeProviders"]:::provider
            BookingP["📋 BookingFlowProvider"]:::provider
            ActiveP["📦 ActiveOrderProvider"]:::provider
            InstallP["⚙️ InstallationFlowProvider"]:::provider
            MaintainP["🛠️ MaintenanceFlowProvider"]:::provider
            RepairP["🔧 RepairFlowProvider"]:::provider
            ProductP["📦 ProductSelectionProvider"]:::provider
        end

        subgraph "Data Flow"
            API["🌐 API Service"]:::api
            Repos["📚 Repositories"]:::api
        end

        subgraph "External"
            Backend["🚀 Backend API"]:::external
        end

        AuthP --> Cart
        AuthP --> DataP
        LocationP --> DataP
        HomeP --> DataP
        BookingP --> Cart
        ActiveP --> Cart
        InstallP --> Cart
        MaintainP --> Cart
        RepairP --> Cart
        ProductP --> Cart

        Cart --> Repos
        DataP --> Repos
        Repos --> API
        API --> Backend

        classDef data fill:#FF9800,color:#fff,stroke:#e65100
        classDef provider fill:#4285F4,color:#fff,stroke:#1a56db
        classDef api fill:#00BCD4,color:#fff,stroke:#00838f
        classDef external fill:#607D8B,color:#fff,stroke:#37474f