rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /PService/{serviceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /Catalog_Product/{productId} {
      allow read;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /Customer_User/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /Orders/{orderId} {
      allow read, write: if request.auth != null && (request.auth.uid == resource.data.customerId || request.auth.token.role == 'admin');
    }
    match /Employee_User/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /Admin_User/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid && request.auth.token.role == 'admin';
    }
    match /Bookings/{bookingId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.customerId || request.auth.token.role in ['admin', 'employee']);
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'employee'];
    }
    match /Configurations/{configId} {
      allow read;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /Banners/{bannerId} {
      allow read;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /Offers/{offerId} {
      allow read;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /Locations/{locationId} {
      allow read;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /Invoices/{invoiceId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.customerId || request.auth.token.role == 'admin');
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}